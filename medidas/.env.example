# Copia este archivo como ".env" y rellénalo.

NOMBRE_NEGOCIO=Carpintería Metálica García

# El primer usuario (administrador). Se crea al arrancar si todavía no hay ninguno.
# Después puedes cambiar la contraseña y añadir más gente desde la propia app.
ADMIN_USUARIO=antonio
ADMIN_NOMBRE=Antonio
ADMIN_CONTRASENA=pon-aqui-una-contrasena

# Déjalo en "si" cuando la app esté en internet con https.
# Ponlo en "no" solo para probarla en tu ordenador con http://localhost.
COOKIE_SEGURA=si
