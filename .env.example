# Copia este archivo como ".env" y rellénalo.

# --- Tu negocio ---
NOMBRE_NEGOCIO=Carpintería Metálica García
NOMBRE_DUENO=Antonio
# Opcional: cambia la frase con la que contesta el asistente.
# SALUDO=Hola, ha llamado a Carpintería Metálica García...

# --- Claude (la inteligencia artificial) ---
# Se saca en https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# --- Twilio (el número de teléfono que contesta) ---
# Está en la portada de la consola de Twilio ("Auth Token").
TWILIO_AUTH_TOKEN=
# La dirección pública donde funciona este programa, sin barra al final.
URL_PUBLICA=https://recados.tudominio.es

# --- Panel de recados (la página donde los lees) ---
PANEL_USUARIO=admin
PANEL_CONTRASENA=pon-aqui-una-contrasena-larga

# --- Avisos al móvil por Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pon "si" para recibir aviso solo de las llamadas urgentes.
AVISAR_SOLO_URGENTES=no
